# Local secrets; only explicit example/testing fixtures belong in source control.
/.env
/.env.*
!/.env.example
!/.env.testing

# Installed dependencies and generated frontend output.
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage

# Generated test output and private runtime files.
/.phpunit.result.cache
/.phpunit.cache/
/storage/logs/*.txt
/storage/logs/*.log
/storage/logs/*.pid
/storage/*.key
/storage/manual-fixture-build/

# Local editor and OS artifacts.
/.idea/
/.vscode/
/.DS_Store
/Thumbs.db
